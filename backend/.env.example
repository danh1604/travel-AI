NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://pickyourway:local_dev_password@localhost:5432/pickyourway
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Planner requires a model supporting Chat Completions function/tool calling.
# AI_BASE_URL includes the provider prefix, usually /v1. Keys stay on backend.
WEATHER_PROVIDER=weatherapi
WEATHER_API_KEY=
# Planner requests at most 3 forecast days; caches by city for 30 minutes.
# Optional source for the legacy import utility; only local/server-side.
MONGODB_SOURCE_URI=
LEGACY_SOURCE_DATABASE=DB_DATN
# Leave unset for automatic selection: local=snapshot, production=postgres.
# CATALOG_SOURCE=snapshot
# Auth defaults: persistent PGlite locally, PostgreSQL in production.
# AUTH_DATABASE_SOURCE=pglite
SESSION_COOKIE_SAME_SITE=lax
# Set the exact trusted reverse-proxy hop count on the VPS (usually 1).
TRUST_PROXY_HOPS=0
