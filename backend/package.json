{
  "name": "@pickyourway/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:reviews": "node --import tsx --test --test-concurrency=1 tests/reviews.test.ts",
    "dev": "npm run db:generate && tsx watch --include .env src/index.ts",
    "build": "npm run db:generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "npm run db:generate && tsc --noEmit && tsc --noEmit --project tsconfig.prisma.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:database": "node --test tests/database.test.mjs",
    "db:import:mongo": "npm run db:generate && tsx scripts/import-mongodb.ts",
    "db:map:legacy": "npm run db:generate && tsx scripts/map-legacy.ts",
    "test:legacy": "node --import tsx --test tests/legacy-mapping.test.ts",
    "catalog:snapshot": "npm run db:generate && tsx scripts/map-legacy.ts --snapshot",
    "test:explore": "node --import tsx --test tests/explore.test.ts",
    "test:auth": "node --import tsx --test --test-concurrency=1 tests/auth.test.ts tests/local-lock.test.ts",
    "auth:admin": "npm run db:generate && tsx scripts/promote-admin.ts",
    "test:ui": "node --import tsx --test tests/ui-shell.test.ts",
    "test:admin": "node --import tsx --test --test-concurrency=1 tests/admin-catalog.test.ts tests/tour-content.test.ts tests/account-admin.test.ts tests/departures.test.ts",
    "test:planner": "node --import tsx --test tests/planner.test.ts",
    "test:trips": "node --import tsx --test --test-concurrency=1 tests/saved-trips.test.ts",
    "test:guides": "node --import tsx --test tests/guides.test.ts",
    "test:rag": "node --import tsx --test --test-concurrency=1 tests/rag.test.ts"
  },
  "dependencies": {
    "@pickyourway/ai-services": "0.1.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "mongodb": "^7.7.0",
    "prisma": "7.9.1",
    "tsx": "^4.23.15"
  }
}
